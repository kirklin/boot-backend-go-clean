server {
    listen       ${GATEWAY_PORT};
    listen  [::]:${GATEWAY_PORT};
    server_name _;

    # Allow large cookies and Cloudflare headers (prevents 400 Bad Request)
    large_client_header_buffers 4 32k;
    client_header_buffer_size 8k;

    # Redirect all HTTP requests to HTTPS
    # Uncomment the following lines if you have SSL certificates
    # return 301 https://$host$request_uri;

    # If no SSL, directly serve here
    location / {
        proxy_pass http://api:${SERVER_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Client IP forwarding — essential for GeoIP resolution and rate limiting.
        # Without these headers, the Go app only sees the Docker gateway IP.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Security Headers
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-XSS-Protection "1; mode=block";
        add_header X-Content-Type-Options "nosniff";
    }
}

